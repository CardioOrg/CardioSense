rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Patient Profiles ─────────────────────────────────────
    match /patient_profiles/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.role == 'doctor'
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Patient Records ──────────────────────────────────────
    match /patient_records/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.role == 'doctor'
      );
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ── Component Runs ───────────────────────────────────────
    match /component_runs/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.role == 'doctor'
      );
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ── Bookings ─────────────────────────────────────────────
    match /bookings/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.role == 'doctor';
    }

    // ── Prescriptions ────────────────────────────────────────
    match /prescriptions/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.role == 'doctor'
      );
      allow create: if request.auth != null && request.auth.token.role == 'doctor';
      allow update: if request.auth != null && request.auth.token.role == 'doctor';
    }

    // ── Chat Sessions ────────────────────────────────────────
    match /chat_sessions/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.token.role == 'doctor'
      );
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── Chat Messages ────────────────────────────────────────
    match /chat_messages/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
